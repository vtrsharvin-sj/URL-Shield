# Copy this file to ".env" and fill in your own values.
# ".env" is gitignored so your real key is never committed.

LOCALHOST_PATH = "../"
DIRECTORY_NAME = "test"
MODEL_PATH = "../models/mlp_model.pkl"
MODEL_PATH_RF = "../models/random_forest.pkl"

# Get a key from https://console.cloud.google.com/ (enable the
# "Safe Browsing API"). Leave blank to disable the Safe Browsing check.
GOOGLE_SAFE_BROWSING_API_KEY = "YOUR_API_KEY_HERE"

# Files used by the security layer (relative to the test/ folder).
BLACKLIST_PATH = "blacklist.txt"
LOG_PATH = "url_shield.log"
